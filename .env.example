# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
# ── YOU DO NOT NEED ALL OF THESE TO START ────────────────────────────────
#
# Thirteen variables reads as thirteen prerequisites, and it is not. The API
# runs with NONE of them set, and each one unlocks a named thing:
#
#   nothing set        /health, /capabilities, /ask/requirements, /ask/revise
#                      all answer. That is the whole Ask flow, and it is
#                      deterministic, so it is also the half worth reading first.
#   DATABASE_URL       /models, /capabilities/{key}, /coverage, /changelog,
#                      /filtered. Without it they answer 503 and say why -
#                      "not the same as a board with nothing on it".
#   OPENROUTER_API_KEY + EXTRACTION_DAILY_BUDGET_USD
#                      /ask/understand, the only endpoint that spends money.
#                      Refuses without BOTH: a key with no cap is an open tab.
#   GITHUB_TOKEN, RAPIDAPI_*
#                      collect/ sweeps only. The API never reads them.
#
# So a stranger cloning this needs: nothing to see it run, one line to see the
# board, and the paid keys only if they want the paid stages.

# ── environment ──────────────────────────────────────────────────────────
# "development" skips the build-fixture assertion. Anything else enforces it:
# production refuses to start if seeded models or hand-curated cells exist.
#
# It ALSO decides what an unset API_TOKEN means - see below.
ENVIRONMENT=development

# ── who may call the API ─────────────────────────────────────────────────
# Unset + ENVIRONMENT=development  → open, and /health says so out loud.
# Unset + any other ENVIRONMENT    → every route refuses. Nobody decided.
# Set                              → Authorization: Bearer <this>, everywhere
#                                    except /health.
#
# THE FRONTEND READS THIS FILE, not web/.env. `web/vite.config.js` loads the
# repo root with an empty prefix - the only way a non-VITE_ name is visible to
# it - and injects this one value as `import.meta.env.VITE_API_TOKEN`. So the
# token lives here once. Setting VITE_API_TOKEN in web/.env has no effect; the
# injected value wins.
#
# Once injected it is IN THE BROWSER BUNDLE and readable by anyone who loads the
# page. That is acceptable for a dev server reaching a token-gated API locally,
# and it is not how a deployed build should authenticate - that needs a session
# the server issues.
API_TOKEN=

# Requests an hour, per caller, on /ask/understand only — the one endpoint that
# spends money. The daily cap bounds the DAY; this stops one caller draining it.
# In-process, so it is per-machine, exactly like the spend cap. 0 disables it.
ASK_RATE_PER_HOUR=20

# ── storage ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/modelboard
RAW_STORE_PATH=./raw_store

# ── GitHub ───────────────────────────────────────────────────────────────
# Personal access token, public_repo scope is enough. Five minutes to create.
#
# Rate limits, read off GitHub's docs on 2026-08-13 rather than assumed:
#   Search API   30 req/min authenticated (code search: 10/min)
#   REST API     5,000 req/hour  ← a SEPARATE budget, not the same pool
#   secondary    100 concurrent, 900 points/min per endpoint
#   ceiling      1,000 results per query, 100 per page
#
# The two budgets matter because harvest is search-then-fetch: the queries
# are Search, the issues and comments they match are REST. Sizing only the
# search half understates the work by orders of magnitude.
#   https://docs.github.com/en/rest/using-the-rest-api/rate-limits-for-the-rest-api
#   https://docs.github.com/en/rest/search/search
GITHUB_TOKEN=

# ── Reddit ── DEFERRED TO WEEK 3, leave blank ────────────────────────────
# The company holds the account; access will be requested later. The adapter
# is not being built. See docs/phase2-readiness.md for why week 3 and not
# week 8: FR-6's acceptance is all three adapters returning content, and
# FR-17's cross-platform identity clustering cannot be tested with one
# social platform.
#
# Register a "script" app at reddit.com/prefs/apps. ~15 minutes. Their terms
# prohibit scraping, so the official API is mandatory.
#
# RATE LIMIT: MEASURED AT 32, WORKING AT 25, ALLOWANCE UNKNOWN.
#
# This comment used to say "BUILD-PLAN says 60 requests/minute and no source
# was ever recorded for it". Both halves were wrong. BUILD-PLAN does not say
# it and never has — no commit in this repository's history adds or removes
# that figure there — so the citation was folklore with a footnote. And the
# number is not merely unsourced: 429 arrives at the 32nd rapid call
# (measured 2026-08-14, message "exceeded the rate limit per minute for your
# plan, PRO", no Retry-After), so a sweep at 60/min fails in its first
# minute. It was wrong in the unsafe direction.
#
#   measured      429 at call 32, clears in ~60s
#   working       SEARCH_PER_MINUTE = 25, chosen under the break point
#   allowance     UNKNOWN. 32 is where it broke, not what PRO permits. No
#                 header states one, so this stays unread rather than
#                 becoming 32 by repetition.
#   quota         READ 2026-08-18, all three headers, one call:
#                   -limit      1000000
#                   -remaining   998660
#                   -reset      2064366  = 23.893 days, resets 2026-09-11
#                 Exactly 1 unit per request, over 558 requests across six
#                 runs and per individual call over the last 186. Captured on
#                 every call now, so each is a dated observation.
#   window        23.9 DAYS, NOT A MONTH. The docstring said ~28 and was wrong
#                 by four days. Costing anything as a "share of a month"
#                 against this quota understates it by a third.
#   billed tier   UNVERIFIED. This line said "1,000,000/month" on the strength
#                 of a docstring, and the reading agrees with it — which is
#                 the uncomfortable outcome, since a right answer from an
#                 unsourced method is the one nobody goes back to check. The
#                 plan page still says 500,000, and a gateway header is not
#                 proof of what RapidAPI bills. If the tier is 500,000 we stop
#                 there with the header reading ~500,000 and looking fine. No
#                 request can settle it; the RapidAPI subscription page can.
#                 A browser, not a call. Same folklore shape as the "60/min"
#                 above, caught the same way — by asking for the denominator.
#
# GitHub's "30/min" was checked on 2026-08-13 and turned out right but
# incomplete, which is the reason to check rather than the reason to trust.
# Read the allowance off Reddit's own terms during the review that
# assert_terms_reviewed() gates, and record it there.
# See docs/measurements/reddit-rate-and-quota.md.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── identification ───────────────────────────────────────────────────────
# NFR-5: identifying User-Agent with a contact URL, on every request, to
# every platform. Not optional, and enforced: collect/http.py refuses to
# build a client without one, in the client constructor rather than at
# startup, so no code path can skip it.
#
# The contact URL must RESOLVE. A dead one is worse than none at all,
# because it looks like diligence to whoever is deciding whether to
# rate-limit us. The value below points at the public repository, which
# exists and identifies the project.
#
# ⚠ If the repository moves or goes private, this stops resolving and must
#   be replaced with a stable public page. The gate cannot detect that; it
#   only rejects empty values, missing URLs and known placeholders.
USER_AGENT=modelboard/0.1 (+https://github.com/parvathibntglobal/Model-Information-Board)

# ── extraction ───────────────────────────────────────────────────────────
# One extractor, decided rather than selected (NFR-9). OpenRouter model id,
# OpenAI-compatible interface. Pinned here so swapping it is a config change.
# There is no fallback: a silent regression halts the batch and flags it for
# re-run rather than failing over. The golden set is what detects that.
EXTRACTOR_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Hard daily ceiling (NFR-3). Degrades to triage-only rather than overrunning.
# Set this BEFORE the first paid call, in week 4.
# Rough shape: docs/day × ~0.13 survival × ~2k tokens × price
EXTRACTION_DAILY_BUDGET_USD=

# ── tests ────────────────────────────────────────────────────────────────
# The write-path tests run DROP SCHEMA public CASCADE, so this is deliberately
# separate from DATABASE_URL: a variable that can wipe a working database on a
# typo eventually will. `scripts/dev-postgres.ps1` creates a disposable local
# instance and writes this into a gitignored .env.test for you.
# See docs/dev-database.md.
TEST_DATABASE_URL=

# Set to 1 to downgrade a missing test database from a failure to a skip.
# The run then prints WRITE PATH NOT COVERED in its summary.
# Do NOT put this in a shell profile: a silently skipped write path is how six
# defects reached a commit with the suite reporting green.
ALLOW_MISSING_TEST_DB=

# ── sign-in ──────────────────────────────────────────────────────────────
# THESE WORK OUT OF THE BOX. Clone, `cp .env.example .env`, and sign in with
#
#     demo@modelboard.dev  /  modelboard-demo
#
# THEY ARE PUBLISHED ON PURPOSE, AND THE APP KNOWS IT. A committed password is
# a door with a known key. A committed SESSION_SECRET is worse in kind: it
# lets anyone MINT a valid token without any password, so sign-in stops
# checking anything. Rather than write "development only" in a comment and
# hope, `judge/login.py` recognises these exact values and /auth/login REFUSES
# them whenever ENVIRONMENT is not `development`. /health reports it too.
#
# Replace all three before deploying anywhere:
#
#     python -m judge.credentials
#
AUTH_EMAIL=demo@modelboard.dev
AUTH_PASSWORD_HASH=pbkdf2_sha256$600000$6f2cb3123559be0ff20b98670686635f$a943ddd50a55030e1ef970aff3ff0249c303a2edc591068f8962bfbd2c64e4c9
SESSION_SECRET=development-only-secret-published-in-env-example-do-not-deploy

# How long a token lasts. A signed token cannot be revoked before it expires,
# so this is the only thing bounding a leaked one.
# Whether the credentials above may be used to sign in.
#
# Unset follows ENVIRONMENT: allowed in development, refused anywhere else.
# Set it to `true` to keep the demo login while ENVIRONMENT is something else -
# the case that needs it is reading the shared database, where
# ENVIRONMENT=staging is correct because it turns the build-fixture guard back
# on, and used to lock you out of the UI as a side effect.
#
# DELIBERATELY LEFT UNSET HERE. Copying this file must not be able to switch it
# on; turning it on has to be something a person typed.
# ALLOW_DEMO_LOGIN=true

SESSION_TTL_HOURS=12

# Sign-in attempts an hour, per address. Brute force is the only attack
# /auth/login is exposed to. 0 disables it.
LOGIN_RATE_PER_HOUR=10
