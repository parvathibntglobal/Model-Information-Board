# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ── environment ──────────────────────────────────────────────────────────
# "development" skips the build-fixture assertion. Anything else enforces it:
# production refuses to start if seeded models or hand-curated cells exist.
ENVIRONMENT=development

# ── storage ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/modelboard
RAW_STORE_PATH=./raw_store

# ── GitHub ───────────────────────────────────────────────────────────────
# Personal access token, public_repo scope is enough. Five minutes to create.
#
# Rate limits, read off GitHub's docs on 2026-08-13 rather than assumed:
#   Search API   30 req/min authenticated (code search: 10/min)
#   REST API     5,000 req/hour  ← a SEPARATE budget, not the same pool
#   secondary    100 concurrent, 900 points/min per endpoint
#   ceiling      1,000 results per query, 100 per page
#
# The two budgets matter because harvest is search-then-fetch: the queries
# are Search, the issues and comments they match are REST. Sizing only the
# search half understates the work by orders of magnitude.
#   https://docs.github.com/en/rest/using-the-rest-api/rate-limits-for-the-rest-api
#   https://docs.github.com/en/rest/search/search
GITHUB_TOKEN=

# ── Reddit ── DEFERRED TO WEEK 3, leave blank ────────────────────────────
# The company holds the account; access will be requested later. The adapter
# is not being built. See docs/phase2-readiness.md for why week 3 and not
# week 8: FR-6's acceptance is all three adapters returning content, and
# FR-17's cross-platform identity clustering cannot be tested with one
# social platform.
#
# Register a "script" app at reddit.com/prefs/apps. ~15 minutes. Their terms
# prohibit scraping, so the official API is mandatory.
#
# RATE LIMIT UNVERIFIED. BUILD-PLAN says 60 requests/minute and no source
# was ever recorded for it. GitHub's "30/min" was checked on 2026-08-13 and
# turned out right but incomplete, which is the reason to check rather than
# the reason to trust. Establish Reddit's real figure during the terms
# review that assert_terms_reviewed() gates, and record it there.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── identification ───────────────────────────────────────────────────────
# NFR-5: identifying User-Agent with a contact URL, on every request, to
# every platform. Not optional, and enforced: collect/http.py refuses to
# build a client without one, in the client constructor rather than at
# startup, so no code path can skip it.
#
# The contact URL must RESOLVE. A dead one is worse than none at all,
# because it looks like diligence to whoever is deciding whether to
# rate-limit us. The value below points at the public repository, which
# exists and identifies the project.
#
# ⚠ If the repository moves or goes private, this stops resolving and must
#   be replaced with a stable public page. The gate cannot detect that; it
#   only rejects empty values, missing URLs and known placeholders.
USER_AGENT=modelboard/0.1 (+https://github.com/parvathibntglobal/Model-Information-Board)

# ── extraction ───────────────────────────────────────────────────────────
# Two qualified, snapshot-pinned extractors (NFR-9). The premise of this
# product is that models change silently behind stable names — so pin the
# snapshot, and keep a second one qualified for automatic failover.
EXTRACTOR_PRIMARY=
EXTRACTOR_FALLBACK=
EXTRACTOR_API_KEY=

# Hard daily ceiling (NFR-3). Degrades to triage-only rather than overrunning.
# Set this BEFORE the first paid call, in week 4.
# Rough shape: docs/day × ~0.13 survival × ~2k tokens × price
EXTRACTION_DAILY_BUDGET_USD=

# ── tests ────────────────────────────────────────────────────────────────
# The write-path tests run DROP SCHEMA public CASCADE, so this is deliberately
# separate from DATABASE_URL: a variable that can wipe a working database on a
# typo eventually will. `scripts/dev-postgres.ps1` creates a disposable local
# instance and writes this into a gitignored .env.test for you.
# See docs/dev-database.md.
TEST_DATABASE_URL=

# Set to 1 to downgrade a missing test database from a failure to a skip.
# The run then prints WRITE PATH NOT COVERED in its summary.
# Do NOT put this in a shell profile: a silently skipped write path is how six
# defects reached a commit with the suite reporting green.
ALLOW_MISSING_TEST_DB=
