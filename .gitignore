# ── secrets ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── the raw store ────────────────────────────────────────────────────────
# Immutable, content-hash addressed, and large. Full text is retained
# privately for verification and reprocessing — it is never republished
# and it does not belong in git.
raw_store/
data/raw/
*.warc
*.warc.gz

# A measurement's local corpus, same rule. `scripts/substitution_slice.py`
# writes 1,297 Reddit posts here so the sieve can be re-run for free; that is
# retained full text, so it stays out of git as firmly as the store proper.
# `git add -A` swept it in once — this is why the pattern is here and not in the
# script's docstring.
_substitution_slice/
_harvest_store/

# The unfiltered sweep's measurement population. Same rule, and one more
# reason: it carries a `delete_after` date in its manifest, and a corpus with
# a deletion date must not be the one thing in the repo that cannot be deleted.
_unfiltered_sweep/
_unfiltered_sweep_v2/
_control_sweep/

# ── python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
# .python-version is deliberately NOT ignored (sign-off item 2). It pins the
# interpreter where pyenv and uv read it, so the pin enforces itself instead
# of being documented. Ignoring it would make the item a silent no-op.

# ── tooling ──────────────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# ── local ────────────────────────────────────────────────────────────────
*.db
*.sqlite3
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json

# ── generated output ─────────────────────────────────────────────────────
site/
exports/
_flattened_probe/
