# The frontend talks to /api, which vite proxies to the backend in dev.
# Nothing here is required for local development.

# Point the dev proxy somewhere other than 127.0.0.1:8000
# BACKEND_URL=http://127.0.0.1:8000

# Absolute API base for a deployed build (skips the proxy entirely)
# VITE_API_URL=https://board.example.com
