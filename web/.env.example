# The frontend talks to /api, which vite proxies to the backend in dev.
# Nothing here is required for local development.

# Point the dev proxy somewhere other than 127.0.0.1:8000
# BACKEND_URL=http://127.0.0.1:8000

# Absolute API base for a deployed build (skips the proxy entirely)
# VITE_API_URL=https://board.example.com

# ── the API token is NOT set here ────────────────────────────────────────
# It lives in the REPO ROOT .env as API_TOKEN, and vite.config.js injects it as
# import.meta.env.VITE_API_TOKEN. One file for one secret.
#
# Setting VITE_API_TOKEN in this directory does nothing - the injected value
# from the root overrides it, so a token written here would look configured and
# have no effect.
